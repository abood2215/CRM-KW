# These default to production-safe values. Set APP_ENV=local and APP_DEBUG=true
# ONLY on your own machine while developing — APP_DEBUG=true leaks stack traces,
# .env values, and DB credentials to any visitor who triggers a 500 error.
APP_NAME="CRM V2"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8001

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# "daily" rotates and prunes old log files automatically (see config/logging.php);
# "single" writes one ever-growing laravel.log with no cleanup — avoid it in production.
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=crm_v2
DB_USERNAME=root
DB_PASSWORD=

# Read-only source for the Phase 5 legacy-data migration command — point at a
# restored production backup, never at live prod. LEGACY_APP_KEY is the OLD
# app's production APP_KEY, needed to decrypt some legacy-encrypted columns.
LEGACY_DB_HOST=127.0.0.1
LEGACY_DB_PORT=3306
LEGACY_DB_DATABASE=mutmaenna_crm
LEGACY_DB_USERNAME=root
LEGACY_DB_PASSWORD=
LEGACY_APP_KEY=

APP_TIMEZONE=Asia/Kuwait
CORS_ALLOWED_ORIGINS=http://localhost:5174

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# WhatsApp Cloud API — app-level settings only. Per-number credentials
# (access token, phone_number_id) are added later through the app's UI
# at Settings > أرقام واتساب, no .env changes needed per number.
WHATSAPP_APP_SECRET=
# Set this to your own long random string (e.g. `openssl rand -hex 32`) — it's
# what Meta must send back to prove a webhook request is genuinely from them.
# A guessable/default value here lets anyone spoof inbound webhook calls.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v21.0

# Baileys (WhatsApp Web/QR) microservice — only needed if you plan to use
# a Baileys-connected number instead of / alongside Cloud API.
BAILEYS_BASE_URL=http://localhost:3001

# Chatwoot — only needed if you use the Chatwoot integration.
CHATWOOT_BASE_URL=http://localhost:3000
CHATWOOT_API_TOKEN=
CHATWOOT_ACCOUNT_ID=1
CHATWOOT_WEBHOOK_SECRET=

# Real-time broadcasting (new messages, notifications, live updates) via
# a self-hosted Laravel Reverb WebSocket server. Run `php artisan reverb:start`
# (behind a process manager) and set BROADCAST_CONNECTION=reverb once ready.
# These same key/host/port/scheme values must also be set as
# VITE_PUSHER_APP_KEY / VITE_PUSHER_HOST / VITE_PUSHER_PORT / VITE_PUSHER_SCHEME
# in the FRONTEND project's own .env (REACT CRM V2/.env) — Vite does not read
# this backend .env file.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

# Error tracking (optional but recommended in production) — sign up free at
# https://sentry.io, create a Laravel project, and paste its DSN here. Silent
# fatal errors and failed queue jobs (e.g. a whole campaign failing) currently
# have no alerting beyond someone noticing manually — this closes that gap.
SENTRY_LARAVEL_DSN=
