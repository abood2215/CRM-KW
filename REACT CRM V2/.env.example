VITE_API_BASE_URL=http://localhost:8001/api

# Real-time broadcasting — must match REVERB_APP_KEY/HOST/PORT/SCHEME set in
# the backend's .env (LARAVEL CRM V2/.env). Despite the "PUSHER" naming,
# these point at the self-hosted Reverb server, not the Pusher cloud service.
VITE_PUSHER_APP_KEY=app-key
VITE_PUSHER_HOST=localhost
VITE_PUSHER_PORT=8080
VITE_PUSHER_SCHEME=http
VITE_PUSHER_APP_CLUSTER=mt1
